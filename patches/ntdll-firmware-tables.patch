--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -2409,6 +2409,13 @@
         *(UINT *)sfti->TableBuffer = 0;
         return STATUS_SUCCESS;
 
+    case ACPI:
+    case FIRM:
+        /* the host firmware has no ACPI tables to expose (Apple Silicon uses a device tree) */
+        sfti->TableBufferLength = 0;
+        *required_len = offsetof( SYSTEM_FIRMWARE_TABLE_INFORMATION, TableBuffer );
+        return STATUS_SUCCESS;
+
     default:
         FIXME("info_class SYSTEM_FIRMWARE_TABLE_INFORMATION provider %08x\n", (unsigned int)sfti->ProviderSignature);
         return STATUS_NOT_IMPLEMENTED;
@@ -2437,6 +2444,14 @@
         memcpy( sfti->TableBuffer, smbios_data, len );
         return STATUS_SUCCESS;
 
+    case ACPI:
+    case FIRM:
+        TRACE( "no %s table %08x on this host\n", sfti->ProviderSignature == ACPI ? "ACPI" : "firmware",
+               (unsigned int)sfti->TableID );
+        sfti->TableBufferLength = 0;
+        *required_len = offsetof( SYSTEM_FIRMWARE_TABLE_INFORMATION, TableBuffer );
+        return STATUS_NOT_FOUND;
+
     default:
         FIXME("info_class SYSTEM_FIRMWARE_TABLE_INFORMATION provider %08x\n", (unsigned int)sfti->ProviderSignature);
         return STATUS_NOT_IMPLEMENTED;
