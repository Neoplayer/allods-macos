+struct _SECURITY_CLIENT_CONTEXT
+{
+    SECURITY_QUALITY_OF_SERVICE SecurityQos;
+    PACCESS_TOKEN ClientToken;
+    BOOLEAN DirectlyAccessClientToken;
+    BOOLEAN DirectAccessEffectiveOnly;
+    BOOLEAN ServerIsRemote;
+    TOKEN_CONTROL ClientTokenControl;
+};
+
+/* the server can't map tokens to kernel objects, so keep our own handle */
+struct client_token
+{
+    HANDLE handle;
+};
+
+/* duplicate the effective token of a client thread as an impersonation token */
+static NTSTATUS open_client_token( PETHREAD client_thread, const SECURITY_QUALITY_OF_SERVICE *qos, HANDLE *ret )
+{
+    SECURITY_QUALITY_OF_SERVICE token_qos = *qos;
+    OBJECT_ATTRIBUTES attr;
+    HANDLE thread, process, token;
+    NTSTATUS status;
+
+    if (!(thread = OpenThread( THREAD_QUERY_INFORMATION, FALSE, HandleToUlong( client_thread->kthread.id.UniqueThread ) )))
+        return STATUS_INVALID_PARAMETER;
+    status = NtOpenThreadToken( thread, TOKEN_DUPLICATE | TOKEN_QUERY, TRUE, &token );
+    NtClose( thread );
+
+    if (status == STATUS_NO_TOKEN)
+    {
+        if (!(process = OpenProcess( PROCESS_QUERY_INFORMATION, FALSE,
+                                     HandleToUlong( client_thread->kthread.id.UniqueProcess ) )))
+            return STATUS_INVALID_PARAMETER;
+        status = NtOpenProcessToken( process, TOKEN_DUPLICATE | TOKEN_QUERY, &token );
+        NtClose( process );
+    }
+    if (status) return status;
+
+    token_qos.Length = sizeof(token_qos);
+    InitializeObjectAttributes( &attr, NULL, 0, NULL, NULL );
+    attr.SecurityQualityOfService = &token_qos;
+    status = NtDuplicateToken( token, TOKEN_ALL_ACCESS, &attr, qos->EffectiveOnly, TokenImpersonation, ret );
+    NtClose( token );
+    return status;
+}
