+NTSTATUS WINAPI PsSetCreateProcessNotifyRoutineEx( PCREATE_PROCESS_NOTIFY_ROUTINE_EX callback, BOOLEAN remove )
+{
+    TRACE( "%p %d\n", callback, remove );
+    return set_process_notify( callback, TRUE, remove );
+}
