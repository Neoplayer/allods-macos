+struct _SECURITY_CLIENT_CONTEXT
+{
+    SECURITY_QUALITY_OF_SERVICE SecurityQos;
+    PACCESS_TOKEN ClientToken;
+    BOOLEAN DirectlyAccessClientToken;
+    BOOLEAN DirectAccessEffectiveOnly;
+    BOOLEAN ServerIsRemote;
+    TOKEN_CONTROL ClientTokenControl;
+};
+
+/* the server can't map tokens to kernel objects, so keep our own handle */
+struct client_token
+{
+    HANDLE handle;
+};
+
+/* duplicate the effective token of a client thread as an impersonation token */
+static NTSTATUS open_client_token( PETHREAD client_thread, const SECURITY_QUALITY_OF_SERVICE *qos, HANDLE *ret )
+{
+    SECURITY_QUALITY_OF_SERVICE token_qos = *qos;
+    OBJECT_ATTRIBUTES attr;
+    HANDLE thread, process, token;
+    NTSTATUS status;
+
+    if (!(thread = OpenThread( THREAD_QUERY_INFORMATION, FALSE, HandleToUlong( client_thread->kthread.id.UniqueThread ) )))
+        return STATUS_INVALID_PARAMETER;
+    status = NtOpenThreadToken( thread, TOKEN_DUPLICATE | TOKEN_QUERY, TRUE, &token );
+    NtClose( thread );
+
+    if (status == STATUS_NO_TOKEN)
+    {
+        if (!(process = OpenProcess( PROCESS_QUERY_INFORMATION, FALSE,
+                                     HandleToUlong( client_thread->kthread.id.UniqueProcess ) )))
+            return STATUS_INVALID_PARAMETER;
+        status = NtOpenProcessToken( process, TOKEN_DUPLICATE | TOKEN_QUERY, &token );
+        NtClose( process );
+    }
+    if (status) return status;
+
+    token_qos.Length = sizeof(token_qos);
+    InitializeObjectAttributes( &attr, NULL, 0, NULL, NULL );
+    attr.SecurityQualityOfService = &token_qos;
+    status = NtDuplicateToken( token, TOKEN_ALL_ACCESS, &attr, qos->EffectiveOnly, TokenImpersonation, ret );
+    NtClose( token );
+    return status;
+}
+
+/***********************************************************************
+ *           SeCreateClientSecurity   (NTOSKRNL.EXE.@)
+ */
+NTSTATUS WINAPI SeCreateClientSecurity( PETHREAD client_thread, SECURITY_QUALITY_OF_SERVICE *qos,
+                                        BOOLEAN remote_session, struct _SECURITY_CLIENT_CONTEXT *context )
+{
+    struct client_token *client_token;
+    HANDLE token;
+    NTSTATUS status;
+
+    TRACE( "thread %p, qos %p, remote %u, context %p\n", client_thread, qos, remote_session, context );
+
+    if (!client_thread || !qos || !context) return STATUS_INVALID_PARAMETER;
+
+    if ((status = open_client_token( client_thread, qos, &token ))) return status;
+    if (!(client_token = alloc_kernel_object( SeTokenObjectType, NULL, sizeof(*client_token), 1 )))
+    {
+        NtClose( token );
+        return STATUS_NO_MEMORY;
+    }
+    client_token->handle = token;
+    context->ClientToken = client_token;
+
+    context->SecurityQos = *qos;
+    context->DirectlyAccessClientToken = FALSE;
+    context->DirectAccessEffectiveOnly = qos->EffectiveOnly;
+    context->ServerIsRemote = remote_session;
+    memset( &context->ClientTokenControl, 0, sizeof(context->ClientTokenControl) );
+
+    return STATUS_SUCCESS;
+}
+
+/***********************************************************************
+ *           SeImpersonateClientEx   (NTOSKRNL.EXE.@)
+ */
+NTSTATUS WINAPI SeImpersonateClientEx( struct _SECURITY_CLIENT_CONTEXT *context, PETHREAD server_thread )
+{
+    struct client_token *client_token = context->ClientToken;
+    HANDLE thread = GetCurrentThread();
+    NTSTATUS status;
+
+    TRACE( "context %p, thread %p\n", context, server_thread );
+
+    if (!client_token || ObGetObjectType( client_token ) != SeTokenObjectType) return STATUS_INVALID_PARAMETER;
+
+    if (server_thread && !(thread = OpenThread( THREAD_SET_THREAD_TOKEN, FALSE,
+                                                HandleToUlong( server_thread->kthread.id.UniqueThread ) )))
+        status = STATUS_INVALID_PARAMETER;
+    else
+        status = NtSetInformationThread( thread, ThreadImpersonationToken,
+                                         &client_token->handle, sizeof(client_token->handle) );
+
+    if (thread && thread != GetCurrentThread()) NtClose( thread );
+    return status;
+}
+
+/***********************************************************************
+ *           SeImpersonateClient   (NTOSKRNL.EXE.@)
+ */
+void WINAPI SeImpersonateClient( struct _SECURITY_CLIENT_CONTEXT *context, PETHREAD server_thread )
+{
+    SeImpersonateClientEx( context, server_thread );
+}
+
+/***********************************************************************
+ *           SeTokenType   (NTOSKRNL.EXE.@)
+ */
+TOKEN_TYPE WINAPI SeTokenType( PACCESS_TOKEN token )
+{
+    struct client_token *client_token = token;
+    TOKEN_TYPE type = TokenPrimary;
+    ULONG size;
+
+    TRACE( "%p\n", token );
+
+    if (client_token && ObGetObjectType( client_token ) == SeTokenObjectType)
+        NtQueryInformationToken( client_token->handle, TokenType, &type, sizeof(type), &size );
+    return type;
+}
+
+/***********************************************************************
+ *           PsDereferencePrimaryToken   (NTOSKRNL.EXE.@)
+ */
+void WINAPI PsDereferencePrimaryToken( PACCESS_TOKEN token )
+{
+    TRACE( "%p\n", token );
+    if (token) ObDereferenceObject( token );
+}
+
+/***********************************************************************
+ *           PsDereferenceImpersonationToken   (NTOSKRNL.EXE.@)
+ */
+void WINAPI PsDereferenceImpersonationToken( PACCESS_TOKEN token )
+{
+    TRACE( "%p\n", token );
+    if (token) ObDereferenceObject( token );
+}
+
