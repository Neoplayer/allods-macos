+/* Drivers handle user-mode handles which belong to the process that issued the
+ * IRP, while wine runs the dispatch code in the device manager process. */
+static HANDLE duplicate_client_handle( HANDLE handle )
+{
+    THREAD_BASIC_INFORMATION info;
+    HANDLE thread, process, ret = NULL;
+
+    if (!(thread = OpenThread( THREAD_QUERY_INFORMATION, FALSE, client_tid )))
+        return NULL;
+
+    if (!NtQueryInformationThread( thread, ThreadBasicInformation, &info, sizeof(info), NULL ) &&
+        (process = OpenProcess( PROCESS_DUP_HANDLE, FALSE, HandleToUlong( info.ClientId.UniqueProcess ) )))
+    {
+        DuplicateHandle( process, handle, GetCurrentProcess(), &ret, 0, FALSE, DUPLICATE_SAME_ACCESS );
+        NtClose( process );
+    }
+    NtClose( thread );
+    return ret;
+}
