+/***********************************************************************
+ *          KeGetProcessorNumberFromIndex   (NTOSKRNL.EXE.@)
+ */
+NTSTATUS WINAPI KeGetProcessorNumberFromIndex( ULONG index, PPROCESSOR_NUMBER number )
+{
+    USHORT group, group_count = GetActiveProcessorGroupCount();
+
+    TRACE( "%lu, %p\n", index, number );
+
+    if (!number) return STATUS_INVALID_PARAMETER;
+
+    for (group = 0; group < group_count; group++)
+    {
+        ULONG count = GetActiveProcessorCount( group );
+
+        if (index < count)
+        {
+            number->Group = group;
+            number->Number = index;
+            number->Reserved = 0;
+            return STATUS_SUCCESS;
+        }
+        index -= count;
+    }
+
+    return STATUS_INVALID_PARAMETER;
+}
